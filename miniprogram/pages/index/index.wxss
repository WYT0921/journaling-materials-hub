/* pages/index/index.wxss */
/* 首页样式 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--color-background-secondary);
}

/* 搜索栏样式 */
.search-bar {
  padding: var(--spacing-md);
  background-color: var(--color-background);
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 var(--spacing-md);
  background-color: var(--color-background-secondary);
  border-radius: var(--radius-full);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: var(--spacing-sm);
  opacity: 0.5;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: var(--font-size-sm);
}

.search-placeholder {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

/* 筛选标签样式 */
.filter-scroll {
  background-color: var(--color-background);
  white-space: nowrap;
}

.filter-chips {
  display: inline-flex;
  padding: var(--spacing-sm) var(--spacing-md);
  gap: var(--spacing-sm);
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 var(--spacing-md);
  background-color: var(--color-background-secondary);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  transition: all 0.2s ease;
}

.filter-chip.active {
  background-color: var(--color-accent);
  color: var(--color-background);
}

/* 素材滚动区域 */
.material-scroll {
  flex: 1;
  padding: var(--spacing-sm);
}

/* 瀑布流布局 */
.waterfall {
  display: flex;
  gap: var(--spacing-sm);
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

/* 素材卡片样式 */
.material-card {
  background-color: var(--color-background);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.card-image-wrapper {
  position: relative;
  width: 100%;
  height: 256rpx;
  overflow: hidden;
}

.card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-image.blurred {
  filter: blur(20rpx);
}

.premium-badge {
  position: absolute;
  top: var(--spacing-sm);
  right: var(--spacing-sm);
  background-color: var(--color-accent);
  color: var(--color-background);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
}

.card-info {
  padding: var(--spacing-sm);
}

.card-title {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  margin-bottom: 4rpx;
}

.card-category {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-accent);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-spinner.small {
  width: 40rpx;
  height: 40rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: var(--spacing-sm);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl);
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.5;
}

.empty-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md);
}

.load-more-text {
  margin-left: var(--spacing-sm);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 没有更多 */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md);
}

.no-more-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}
